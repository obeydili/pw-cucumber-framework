{
  "name": "pw-cucumber-framework",
  "version": "1.0.0",
  "description": "BDD test automation framework for a trading web app, built with Playwright, Cucumber and TypeScript (UI, API and hybrid scenarios).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "pretest": "npm run auth:save",
    "test": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:dry": "NODE_OPTIONS='--import tsx' cucumber-js --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts cucumber.js && prettier --check \"**/*.{ts,js,json}\"",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "auth:save": "tsx scripts/save-auth.ts"
  }
}
