{
  "name": "my-framework",
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "test": "NODE_OPTIONS='--import tsx' cucumber-js --import 'src/support/**/*.ts' --import 'src/steps/**/*.ts' --format html:reports/cucumber-report.html --format progress",
    "test:dry": "NODE_OPTIONS='--import tsx' cucumber-js --dry-run",
    "typecheck": "tsc --noEmit"
  }
}
