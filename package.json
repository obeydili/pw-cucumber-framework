{
  "name": "my-framework",
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "pretest": "npm run auth:save",
    "test": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:dry": "NODE_OPTIONS='--import tsx' cucumber-js --dry-run",
    "typecheck": "tsc --noEmit",
    "auth:save": "tsx scripts/save-auth.ts"
  }
}
